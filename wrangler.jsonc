// Cloudflare Workers config for 3iaw.com: the repo's files are the site, worker/index.js answers /api/*.
{
  "name": "3iaw-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // reviews, orders, paid marks and contact messages
  "kv_namespaces": [
    { "binding": "DATA", "id": "8b92621caee5486183bc7ad08b996000" }
  ],
  // refresh the saved Roblox numbers (worker/index.js scheduled)
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
